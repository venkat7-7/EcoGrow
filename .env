# ═══════════════════════════════════════════════════
#  EcoGrow v4 — Environment (ready to use)
#  Place this file in your project root as: .env
# ═══════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ─────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/ecogrow_db

# ── JWT Secrets (pre-generated, safe to use) ─────────
JWT_SECRET=40465ad1dc3c162f6885e3f22528d31700a1efa2eba82d601ea62aca0995e50445a0b77514fbfd2cfaf16d74336d38cdc43ce80dfc061df18a296884075d00d8
JWT_REFRESH_SECRET=d49c077c88a43f47d8e5e4469a1a8345bc1ccd4e63a9232239e3655e99e582635c65ecf8e5763583b52ce9c4b44b2030470e343d50c2cb8d82643020a4ed340f

# ── Admin Seed ───────────────────────────────────────
# Default password for the 'admin' account on first run
# Login: admin / admin123  → change via Profile after first login
ADMIN_DEFAULT_PASSWORD=admin123

# ── Email (optional) ─────────────────────────────────
# Leave blank to disable email notifications
# To enable: use a Gmail App Password (not your main password)
# Create one at: https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=
ADMIN_EMAIL=adminecogrow@gmail.com

# ── AI Plant Advisor (optional) ──────────────────────
# Leave blank to disable the Sage chatbot
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── CORS ─────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500,null

# ── Inventory ────────────────────────────────────────
LOW_STOCK_THRESHOLD=5